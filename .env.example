# KubePilot configuration — copy to .env and adjust.

# --- LLM provider: ollama | gemini | openai | anthropic ---
LLM_PROVIDER=ollama
MODEL_NAME=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# For gemini:    LLM_PROVIDER=gemini, MODEL_NAME=gemini-2.0-flash, GOOGLE_API_KEY=...
# For openai:    LLM_PROVIDER=openai, MODEL_NAME=gpt-4o, OPENAI_API_KEY=..., OPENAI_BASE_URL=...
# For anthropic: LLM_PROVIDER=anthropic, MODEL_NAME=claude-3-5-sonnet-20241022, ANTHROPIC_API_KEY=...
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
TEMPERATURE=0.2

# --- Kubernetes ---
KUBECONFIG=~/.kube/config
# KUBE_CONTEXT=
DEFAULT_NAMESPACE=default

# --- Observability ---
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100

# --- GitHub (read-only inspection of Actions runs/commits) ---
# GITHUB_TOKEN=

# --- Safety ---
# When true, operational tools (restart/scale/rollback) are blocked entirely.
READ_ONLY=false
# When true, operational tools require approval via the API before executing.
REQUIRE_APPROVAL=true
AUDIT_LOG_PATH=logs/audit.jsonl

# --- Notifications & Webhooks (Slack, Discord, or generic webhook for approval requests) ---
# WEBHOOK_URL=https://example.com/webhook
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
